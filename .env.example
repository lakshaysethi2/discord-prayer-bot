DISCORD_BOT_TOKEN=your-bot-token-here
ADMIN_TOKEN=change-me-to-a-secure-random-string
DATABASE_PATH=./data/prayer_bot.db
GUILD_ID=

# --- Daily "Pray for a Friend" ticket draw (issue #16) ----------------------
# Seeds only: values are stored in the DB (daily_draw_config) on first run;
# afterwards the DB is the source of truth and these env vars are ignored.
# Change the text channel at runtime with:
#   @bot setticketdrawchannel <channel-id>
# Placeholder below is not a real Discord channel.
PRAYER_DRAW_CHANNEL_ID=0000000000000000000
# Role whose members form the random draw pool (the 🗝️ role).
PRAYER_DRAW_ROLE_ID=1481586542911684648
# Per-user cooldown between successful draws, in hours.
PRAYER_DRAW_COOLDOWN_HOURS=18
# Local hour (0-23) of the daily post in the configured timezone.
PRAYER_DRAW_POST_HOUR=7
# Timezone for the daily post scheduling (DST-aware via zone database).
DAILY_DRAW_TIMEZONE=Europe/Paris
# Append-only draw history log (one line per successful draw; gitignored).
PRAYER_DRAW_LOG_PATH=./data/daily_draw_log.txt
